# -*- mode: ruby -*-
# vi: set ft=ruby :

Vagrant.configure("2") do |config|
  config.vm.box = "bento/centos-stream-9"
  config.vm.box_check_update = false

  # Define the nodes
  nodes = [
    { :name => "kube-control-1", :ip => "192.168.56.111" },
    { :name => "kube-worker-1", :ip => "192.168.56.112" },
    { :name => "kube-worker-2", :ip => "192.168.56.113" }
  ]

  # Provision each node
  nodes.each do |node|
    config.vm.define node[:name] do |config|
      config.vm.hostname = node[:name]

      config.vm.network "public_network", bridge: "BRIDGE_INTERFACE_NAME"
      config.vm.network "private_network", ip: node[:ip]

      config.vm.provider "virtualbox" do |vb|
        vb.name = node[:name]
        vb.memory = 2048
        vb.cpus = 2
      end

      config.vm.disk :disk, size: "20GB", primary: true

      config.vm.provision "shell", inline: <<-SHELL
        # Update system
        dnf update -y

        # Install basic packages
        dnf install -y vim net-tools tcpdump nmap iptables-services

        # Set timezone
        timedatectl set-timezone Asia/Dhaka

        # Disable SELinux
        setenforce 0
        sed -i 's/^SELINUX=enforcing$/SELINUX=permissive/' /etc/selinux/config

        # Disable swap
        swapoff -a
        sed -i '/swap/d' /etc/fstab

        # Configure firewall
        systemctl enable --now firewalld
        firewall-cmd --permanent --add-port=6443/tcp
        firewall-cmd --permanent --add-port=2379-2380/tcp
        firewall-cmd --permanent --add-port=10250/tcp
        firewall-cmd --permanent --add-port=10251/tcp
        firewall-cmd --permanent --add-port=10252/tcp
        firewall-cmd --permanent --add-port=10255/tcp
        firewall-cmd --reload

        # Enable IP forwarding
        echo "net.ipv4.ip_forward = 1" >> /etc/sysctl.conf
        sysctl -p

        # Set up hosts file
        echo "192.168.56.111 kube-control-1" >> /etc/hosts
        echo "192.168.56.112 kube-worker-1" >> /etc/hosts
        echo "192.168.56.113 kube-worker-2" >> /etc/hosts

        # Install container runtime (containerd)
        dnf config-manager --add-repo=https://download.docker.com/linux/centos/docker-ce.repo
        dnf install -y containerd.io
        mkdir -p /etc/containerd
        containerd config default | tee /etc/containerd/config.toml
        systemctl enable --now containerd

        # Load necessary modules
        cat <<EOF | tee /etc/modules-load.d/k8s.conf
overlay
br_netfilter
EOF
        modprobe overlay
        modprobe br_netfilter

        # Set up required sysctl params
        cat <<EOF | tee /etc/sysctl.d/k8s.conf
net.bridge.bridge-nf-call-iptables  = 1
net.bridge.bridge-nf-call-ip6tables = 1
net.ipv4.ip_forward                 = 1
EOF
        sysctl --system
      SHELL
    end
  end
end
